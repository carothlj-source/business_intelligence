err.type <- factor(c(rep("traning", length(trn.errors)), (rep("validation", length(val.errors)))))
df.errors <- df(type = err.type, err = all.errors)
trn.errors <- with(df.trn, Price - pred.val) # or reg$residuals
val.errors <- with(df.val, Price - pred.val)
all.errors <- c(trn.errors, val.errors)
err.type <- factor(c(rep("traning", length(trn.errors)), (rep("validation", length(val.errors)))))
df.errors <- data.frame(type = err.type, err = all.errors)
plot(err ~ type, data = err.df)
trn.errors <- with(df.trn, Price - pred.val) # or reg$residuals
val.errors <- with(df.val, Price - pred.val)
all.errors <- c(trn.errors, val.errors)
err.type <- factor(c(rep("traning", length(trn.errors)), (rep("validation", length(val.errors)))))
df.errors <- data.frame(type = err.type, err = all.errors)
plot(err ~ type, data = df.errors)
boxplot(trn.errors, val.errors)
