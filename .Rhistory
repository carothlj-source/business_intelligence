iter <- 100000
a <- 23+1
b <- 177+1
a1 <- 28+1
b1 <- 172+1
count <- c()
for (i in 1:iter){
A <- rbeta(1, a, b)
B <- rbeta(1, a1, b1)
count[i] <- ifelse(A>B, 1, 0)
}
pdiff <- sum(count)/iter
pdiff
